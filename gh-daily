#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="gh-daily"

show_help() {
  cat <<EOF
gh-daily: Daily commit digest generator

Generate a digest of all commits by an author on a specific date.
Output formats include plain text (readable out loud) and markdown (exportable as email).

Usage:
  gh daily --author <username> --date <YYYY-MM-DD> [options]

Options:
  -a, --author <username>   GitHub username (required)
  -d, --date <YYYY-MM-DD>   Date for the digest (required)
  -r, --repo <owner/repo>   Limit to specific repository
  -f, --format <format>     Output format: text, markdown, email (default: text)
  -v, --verbose             Show full commit message body
  --no-color                Disable colored output
  --help, -h                Show this help message

Examples:
  gh daily --author johndoe --date 2024-01-15
  gh daily -a johndoe -d 2024-01-15 -r myorg/myrepo -f markdown
  gh daily -a johndoe -d 2024-01-15 -f email | tee digest.txt

Format notes:
  text     - Plain text, suitable for reading aloud
  markdown - Markdown format, suitable for email or docs
  email    - Email-ready plain text with subject line

Exit codes:
  0 - Success
  1 - Error (missing args, API failure, etc.)
  2 - No commits found
EOF
}

AUTHOR=""
DATE=""
REPO=""
FORMAT="text"
VERBOSE=false
NO_COLOR=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--author)
      AUTHOR="$2"
      shift 2
      ;;
    -d|--date)
      DATE="$2"
      shift 2
      ;;
    -r|--repo)
      REPO="$2"
      shift 2
      ;;
    -f|--format)
      FORMAT="$2"
      shift 2
      ;;
    -v|--verbose)
      VERBOSE=true
      shift
      ;;
    --no-color)
      NO_COLOR=true
      shift
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "Error: Unknown option '$1'"
      show_help
      exit 1
      ;;
  esac
done

if [[ -z "$AUTHOR" ]]; then
  echo "Error: --author is required"
  show_help
  exit 1
fi

if [[ -z "$DATE" ]]; then
  echo "Error: --date is required"
  show_help
  exit 1
fi

if ! date -d "$DATE" "+%Y-%m-%d" &>/dev/null; then
  echo "Error: Invalid date '$DATE'. Use YYYY-MM-DD format."
  exit 1
fi

if [[ ! "$FORMAT" =~ ^(text|markdown|email)$ ]]; then
  echo "Error: Format must be text, markdown, or email (got: $FORMAT)"
  exit 1
fi

BOLD=""
DIM=""
RESET=""
if [[ "$NO_COLOR" == false ]] && [[ -t 1 ]]; then
  BOLD="\033[1m"
  DIM="\033[2m"
  RESET="\033[0m"
fi

if ! gh auth status &>/dev/null; then
  echo "Error: Not authenticated with GitHub CLI. Run 'gh auth login' first."
  exit 1
fi

QUERY="author:${AUTHOR}+author-date:${DATE}"
[[ -n "$REPO" ]] && QUERY="${QUERY}+repo:${REPO}"

echo "Searching commits for ${AUTHOR} on ${DATE}..." >&2
[[ -n "$REPO" ]] && echo "  Repository: ${REPO}" >&2

COMMITS="[]"
PAGE=1

while true; do
  RESPONSE=$(gh api \
    --method GET \
    "search/commits?q=${QUERY}&per_page=100&page=${PAGE}" \
    --jq '{total: .total_count, items: .items}' 2>/dev/null) || {
    echo "Error: API request failed. Check your network and permissions."
    exit 1
  }

  ITEMS=$(echo "$RESPONSE" | jq '.items // []')
  ITEM_COUNT=$(echo "$ITEMS" | jq 'length')
  [[ "$ITEM_COUNT" -eq 0 ]] && break

  COMMITS=$(echo "$COMMITS" "$ITEMS" | jq -s 'add')

  if [[ "$ITEM_COUNT" -lt 100 ]]; then
    break
  fi
  PAGE=$((PAGE + 1))
  if [[ "$PAGE" -gt 10 ]]; then
    echo "Warning: More than 1000 commits found. Results truncated." >&2
    break
  fi
done

COMMIT_COUNT=$(echo "$COMMITS" | jq 'length')

if [[ "$COMMIT_COUNT" -eq 0 ]]; then
  echo "No commits found for ${AUTHOR} on ${DATE}."
  exit 2
fi

REPO_COUNT=$(echo "$COMMITS" | jq '[.[].repository.full_name] | unique | length')

if [[ "$VERBOSE" == true ]]; then
  REPO_GROUPS=$(echo "$COMMITS" | jq -c '
    group_by(.repository.full_name)
    | sort_by(-length)
    | .[]
    | {
        repo: .[0].repository.full_name,
        repo_url: .[0].repository.html_url,
        count: length,
        commits: [.[] | {
          sha: .sha[0:7],
          subject: (.commit.message | split("\n")[0]),
          body:  (.commit.message | split("\n")[1:] | map(select(length > 0)) | if length > 0 then join("\n") else "" end),
          url: .html_url
        }]
      }
  ')
else
  REPO_GROUPS=$(echo "$COMMITS" | jq -c '
    group_by(.repository.full_name)
    | sort_by(-length)
    | .[]
    | {
        repo: .[0].repository.full_name,
        repo_url: .[0].repository.html_url,
        count: length,
        commits: [.[] | {
          sha: .sha[0:7],
          subject: (.commit.message | split("\n")[0]),
          url: .html_url
        }]
      }
  ')
fi

print_commit_text() {
  local c=$1
  local indent=${2:-2}
  local prefix=${3:-"•"}
  local spc
  spc=$(printf '%*s' "$indent" '')

  local sha
  sha=$(echo "$c" | jq -r '.sha // ""')
  local subject
  subject=$(echo "$c" | jq -r '.subject // ""')

  printf "%s${prefix} %s ${DIM}(%s)${RESET}\n" "$spc" "$subject" "$sha"

  if [[ "$VERBOSE" == true ]]; then
    local body
    body=$(echo "$c" | jq -r '.body // ""')
    if [[ -n "$body" ]]; then
      local body_indent=$((indent + 2))
      local body_spc
      body_spc=$(printf '%*s' "$body_indent" "")
      echo "$body" | sed "s/^/${body_spc}/" | sed '/^$/d'
      printf "\n"
    fi
  fi
}

print_commit_md() {
  local c=$1
  local sha
  sha=$(echo "$c" | jq -r '.sha // ""')
  local subject
  subject=$(echo "$c" | jq -r '.subject // ""')

  printf -- "- \`%s\` %s\n" "$sha" "$subject"

  if [[ "$VERBOSE" == true ]]; then
    local body
    body=$(echo "$c" | jq -r '.body // ""')
    if [[ -n "$body" ]]; then
      echo "$body" | sed 's/^/  > /'
    fi
  fi
}

print_commit_email() {
  local c=$1
  local sha
  sha=$(echo "$c" | jq -r '.sha // ""')
  local subject
  subject=$(echo "$c" | jq -r '.subject // ""')

  printf "  - %s (%s)\n" "$subject" "$sha"

  if [[ "$VERBOSE" == true ]]; then
    local body
    body=$(echo "$c" | jq -r '.body // ""')
    if [[ -n "$body" ]]; then
      echo "$body" | sed 's/^/    /' | sed '/^    $/d'
      printf "\n"
    fi
  fi
}

case "$FORMAT" in
  text)
    printf "${BOLD}Daily Commit Digest${RESET}\n"
    printf "%s\n" "$(printf '=%.0s' {1..60})"
    printf "Author: %s\n" "$AUTHOR"
    printf "Date:   %s\n" "$DATE"
    printf "%s\n" "$(printf '=%.0s' {1..60})"
    printf "\n"
    printf "Found ${BOLD}%d${RESET} commits across ${BOLD}%d${RESET} repositor%s.\n" \
      "$COMMIT_COUNT" "$REPO_COUNT" "$( [[ $REPO_COUNT -eq 1 ]] && echo 'y' || echo 'ies' )"
    printf "\n"

    while IFS= read -r group; do
      REPO_NAME=$(echo "$group" | jq -r '.repo')
      GROUP_COUNT=$(echo "$group" | jq -r '.count')
      printf "${BOLD}%s${RESET} (%d commit%s)\n" "$REPO_NAME" "$GROUP_COUNT" "$( [[ $GROUP_COUNT -eq 1 ]] && echo '' || echo 's' )"
      echo "$group" | jq -c '.commits[]' | while IFS= read -r c; do
        print_commit_text "$c"
      done
      printf "\n"
    done <<< "$REPO_GROUPS"

    printf "%s\n" "$(printf '=%.0s' {1..60})"
    printf "Summary: %d commits across %d repositor%s\n" \
      "$COMMIT_COUNT" "$REPO_COUNT" "$( [[ $REPO_COUNT -eq 1 ]] && echo 'y' || echo 'ies' )"
    printf "Generated by gh-daily on %s\n" "$(date "+%Y-%m-%d %H:%M:%S")"
    ;;

  markdown)
    printf "# Daily Commit Digest\n\n"
    printf "**Author:** %s  \n" "$AUTHOR"
    printf "**Date:** %s  \n\n" "$DATE"
    printf "Found **%d** commits across **%d** repositor%s.\n\n" \
      "$COMMIT_COUNT" "$REPO_COUNT" "$( [[ $REPO_COUNT -eq 1 ]] && echo 'y' || echo 'ies' )"
    printf -- "---\n\n"

    while IFS= read -r group; do
      REPO_NAME=$(echo "$group" | jq -r '.repo')
      GROUP_COUNT=$(echo "$group" | jq -r '.count')
      printf "### %s (%d commit%s)\n\n" "$REPO_NAME" "$GROUP_COUNT" "$( [[ $GROUP_COUNT -eq 1 ]] && echo '' || echo 's' )"
      echo "$group" | jq -c '.commits[]' | while IFS= read -r c; do
        print_commit_md "$c"
      done
      printf "\n"
    done <<< "$REPO_GROUPS"

    printf -- "---\n\n"
    printf "**Summary:** %d commits across %d repositor%s  \n" \
      "$COMMIT_COUNT" "$REPO_COUNT" "$( [[ $REPO_COUNT -eq 1 ]] && echo 'y' || echo 'ies' )"
    printf "_Generated by gh-daily on %s_\n" "$(date "+%Y-%m-%d %H:%M:%S")"
    ;;

  email)
    cat << EMAIL_HEADER
Subject: Daily Commit Digest - ${AUTHOR} - ${DATE}
To: RECIPIENT@example.com

Hi,

Here is the commit digest for ${AUTHOR} on ${DATE}:

Found ${COMMIT_COUNT} commits across ${REPO_COUNT} repositor$( [[ $REPO_COUNT -eq 1 ]] && echo 'y' || echo 'ies' ).

---

EMAIL_HEADER

    while IFS= read -r group; do
      REPO_NAME=$(echo "$group" | jq -r '.repo')
      GROUP_COUNT=$(echo "$group" | jq -r '.count')
      printf "Repository: %s (%d commit%s)\n" "$REPO_NAME" "$GROUP_COUNT" "$( [[ $GROUP_COUNT -eq 1 ]] && echo '' || echo 's' )"
      echo "$group" | jq -c '.commits[]' | while IFS= read -r c; do
        print_commit_email "$c"
      done
      printf "\n"
    done <<< "$REPO_GROUPS"

    printf -- "---\n\n"
    printf "Summary: %d commits across %d repositor%s\n" \
      "$COMMIT_COUNT" "$REPO_COUNT" "$( [[ $REPO_COUNT -eq 1 ]] && echo 'y' || echo 'ies' )"
    printf "\n"
    printf "This digest was automatically generated by gh-daily.\n"
    ;;
esac
